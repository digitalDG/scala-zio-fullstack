# Copy to `.env` and fill in DB_PASSWORD. `.env` is git-ignored; never commit real values.
# Both Docker Compose and `sbt run` read it.

# --- Required -----------------------------------------------------------------------------------

# Password for the PostgreSQL `todo` user. Generate one with: openssl rand -base64 32
DB_PASSWORD=

# --- Optional: uncomment a line to change its default -------------------------------------------

# HTTP_PORT=8080
# Only set to false for a plain-HTTP host other than localhost.
# HTTP_SECURE_COOKIES=true

# Docker Compose sets its own DB_URL pointing at the `db` container.
# DB_URL=jdbc:postgresql://localhost:5432/todo
# DB_USER=todo
# DB_MAX_POOL_SIZE=10

# How long a sign-in lasts.
# SESSION_TTL_MINUTES=720

# Failed sign-ins allowed per account and per client address within the window.
# LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
# LOGIN_MAX_ATTEMPTS_PER_IP=20
# LOGIN_WINDOW_MINUTES=15

# --- Docker Compose host ports ------------------------------------------------------------------

# APP_PORT=3000
# API_PORT=8080
# DB_PORT=5432
